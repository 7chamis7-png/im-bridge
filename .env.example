# im-bridge example configuration.
# Copy to .env and load it into the environment of each process
# (e.g. `set -a; . ./.env; set +a` or your process manager's env file).
# Empty value = feature off / not configured.

# ---------------------------------------------------------------- core
# Base data directory (default ~/.im-bridge)
IM_BRIDGE_HOME=
# Bridge storage root: ledgers, cursors, cold log, sockets (required)
GATE_ROOT=/home/you/.im-bridge/gate
# Session binding key stored in sessions.json (required)
GATE_BINDING_KEY=main
# Working directory of the Claude Code session (required)
GATE_WORKSPACE_ROOT=/home/you/agent-workspace
# Chat id used when the agent speaks first (Telegram chat id; required)
GATE_PREFERRED_CHAT_ID=
# im-gate must run with GATE_BOX=remote; im-box uses the default (claudecode)
GATE_BOX=remote

# ---------------------------------------------------------------- identity
GATE_OWNER_NAME=owner
GATE_OWNER_PRONOUN=they
# The owner's platform ids, comma-separated if several (GATE_OWNER_<CHANNEL>_ID)
GATE_OWNER_TELEGRAM_ID=
GATE_OWNER_WECHAT_ID=
GATE_OWNER_IMESSAGE_ID=
GATE_OWNER_PHONE_ID=

# ---------------------------------------------------------------- model / session
GATE_MODEL=
GATE_FALLBACK_MODEL=
GATE_MODEL_CHOICES=
GATE_CLAUDE_COMMAND=claude
GATE_CLAUDE_PERMISSION_MODE=default
GATE_CLAUDE_PARTIAL=
GATE_SYSTEM_PROMPT_FILE=
GATE_PERSONA=./examples/persona
GATE_PERSONA_NAME=agent
GATE_MEMORY_DIR=
GATE_IDENTITY_INJECTION_FILE=
GATE_EXTRA_MCP=
GATE_BOX_CONTEXT_LIMIT=

# ---------------------------------------------------------------- time
GATE_TZ=UTC
GATE_TZ_LABEL=
GATE_OUTWARD_TZ=
GATE_OUTWARD_LOCALE=en-US
GATE_TZ_OFFSET_HOURS=0

# ---------------------------------------------------------------- groups
GATE_GROUPS_ALLOWED=
GATE_GROUPS_ALWAYS_WAKE=
GATE_GROUP_NAMES=
GATE_GROUP_WAKE_NAMES=

# ---------------------------------------------------------------- watchdog / context
GATE_WATCH_MS=30000
GATE_HIGH_WATER_RATIO=0.85
GATE_AUTO_ROTATE_RATIO=0
GATE_AUTO_ROTATE_COOLDOWN_MS=1800000
GATE_TRIM_MIN_GAIN_TOKENS=80000

# ---------------------------------------------------------------- codex engine (iris; see examples/iris-env.example.sh)
# app-server 的 -c 覆盖，只在 cli 宿主进程里生效。自压缩关不掉，桥要在它前面换舱（GATE_AUTO_ROTATE_RATIO）。
CODEX_MODEL_CONTEXT_WINDOW=
CODEX_AUTO_COMPACT_TOKEN_LIMIT=
GATE_ENGINE=

# ---------------------------------------------------------------- alerts (optional)
GATE_NOTIFY_BOT_TOKEN=
GATE_NOTIFY_BOT_SECRET=
GATE_NOTIFY_CHAT_ID=

# ---------------------------------------------------------------- im-cli
AGENT_CLI_PATH=/usr/bin/claude
AGENT_CLI_SOCKET=
AGENT_CLI_SCOPE=box
AGENT_CLI_STOP_GRACE_MS=3000

# ---------------------------------------------------------------- Telegram leg
GATE_TELEGRAM_TOKEN=
GATE_BOT_ID=
GATE_BOT_USERNAME=
GATE_POLL_TIMEOUT_SEC=25
GATE_STICKER_PACKS=
GATE_STICKER_OWNER=

# ---------------------------------------------------------------- iMessage leg (+ im-imessage feeder)
GATE_IMESSAGE_INBOX_DIR=
GATE_IMESSAGE_SOCKET=
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
AGENT_IMESSAGE_ALLOWED_HANDLES=

# ---------------------------------------------------------------- WeChat leg (see README warning)
GATE_WECHAT_KEYS_FILE=
GATE_WECHAT_IMAGE_KEY_FILE=
GATE_WECHAT_WHITELIST_FILE=
GATE_WECHAT_SENDER=./src/gate/plugins/wechat/linux-wx-send-a11y.py
GATE_WECHAT_TARGET=
GATE_WECHAT_SEND_LOCK=
GATE_WECHAT_DISPLAY=:0
GATE_WECHAT_MIC_SINK=agent_mic_sink
GATE_WECHAT_GAP_MIN_MS=1000
GATE_WECHAT_GAP_MAX_MS=3000

# ---------------------------------------------------------------- phone leg
GATE_PHONE_INBOX_DIR=
GATE_PHONE_SOCKET=

# ---------------------------------------------------------------- capabilities (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
AGENT_IMAGE_API_KEY=
AGENT_IMAGE_MODEL=
AGENT_TRANSCRIPTION_API_KEY=
AGENT_TRANSCRIPTION_LOCAL=
AGENT_ACOUSTIC_SCRIPT=

# ---------------------------------------------------------------- im-heart (check-ins / reminders)
GATE_CHECKIN_CONFIG_FILE=
GATE_CHECKIN_TEXTS_FILE=
GATE_REMINDER_QUEUE_FILE=
AGENT_NOTEBOOK_MODULE=
AGENT_NOTEBOOK_FILE=
