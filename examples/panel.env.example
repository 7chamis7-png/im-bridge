# im-bridge 面板的配置样例（docs/panel.md 有全表）。复制到仓库外，改成你的，起面板时 source 它。
# 例：env -i HOME="$HOME" PATH="$PATH" bash -c 'set -a; . ~/.im-bridge-panel.env; set +a; exec node src/panel/server.js'

PANEL_PORT=8790
PANEL_STATE_DIR=$HOME/.im-bridge-panel

# 角色名单：id:那一位的 env 文件。不写就扫 ~/.*-gate/*-env.sh
PANEL_CHARACTERS=alpha:$HOME/.alpha-gate/alpha-env.sh,beta:$HOME/.beta-gate/beta-env.sh
# 面板上的显示名（不写就用 env 里的 GATE_AGENT_DISPLAY_NAME，再没有就用 id）
PANEL_NAMES=alpha:晨星,beta:暮雨
# 点缀色：sapphire / ruby / emerald / amber
PANEL_ACCENTS=alpha:ruby,beta:sapphire

# 对外地址（生成登录链接用；https 时 cookie 带 Secure）
# PANEL_PUBLIC_URL=https://panel.example.com

# 会话期限（天，滑动续期）、每个文件留几份旧版
PANEL_SESSION_DAYS=3650
PANEL_BACKUP_KEEP=20

# 界面语言 zh / en / auto；时区；文案覆盖
PANEL_LANG=zh
PANEL_TZ=Asia/Shanghai
# PANEL_COPY_FILE=$HOME/.im-bridge-panel/copy.json

# 可选主题图（本地文件）
# PANEL_HERO_IMAGE=$HOME/.im-bridge-panel/theme/hero.webp
# PANEL_NIGHT_IMAGE=$HOME/.im-bridge-panel/theme/night.webp
